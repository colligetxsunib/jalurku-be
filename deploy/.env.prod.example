# Salin ke deploy/.env.prod (tidak masuk repositori) lalu isi. Dipakai deploy.sh dan init-cert.sh.
# Nilai ditulis apa adanya, tanpa tanda kutip, tanpa spasi, dan tanpa komentar di baris yang sama.

# --- Domain & TLS ---
# Nama host publik. Untuk uji lokal tanpa HTTPS pakai: DOMAIN=localhost
DOMAIN=jalurku.contoh.id
# Email untuk pemberitahuan kedaluwarsa Let's Encrypt (dipakai init-cert.sh)
ACME_EMAIL=
# Port host. Default 80/443; ubah hanya untuk uji lokal (mis. HTTP_PORT=8080).
# Let's Encrypt mensyaratkan port 80 dan 443 asli, jadi HTTPS publik tidak bisa memakai port lain.
HTTP_PORT=80
HTTPS_PORT=443

# --- Database ---
# Hanya huruf dan angka (dipakai di URL koneksi). Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Aplikasi ---
# Kunci Google AI Studio. Kosong = RAG/narasi memakai fallback, semua keputusan tetap jalan.
GEMINI_API_KEY=
# Nama model (kosong = bawaan config/app.yaml). Cari nama valid: python -m scripts.list_models
LLM_MODEL=
# Cadangan generate, dipisah koma, dicoba saat model utama 404 atau 429.
LLM_MODEL_FALLBACK=
# DIKUNCI bersama dimensi 768; mengganti berarti re-embed semua chunk.
EMBED_MODEL=
# Kunci POST /admin/*. Kosong = endpoint admin nonaktif (404). Buat dengan: openssl rand -hex 32
ADMIN_KEY=
# Origin frontend yang diizinkan (pisahkan koma), mis. https://jalurku-ui.contoh.id
CORS_ORIGINS=
SESSION_TTL_HOURS=24
# Nyalakan (true) sebelum rekam video dan submit. Ingest menolak baris tanpa terakhir_diverifikasi, dan
# API menolak start bila rules_jalur, ketentuan, atau acuan_skor masih memuat baris tanpa tanggal.
# Tanggal hanya diisi manusia setelah verifikasi. Cek kesiapan:
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.prod.yml exec api python -m scripts.check_verified
REQUIRE_VERIFIED=false
