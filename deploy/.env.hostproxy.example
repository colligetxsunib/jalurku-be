# Salin ke deploy/.env.prod (tidak masuk repositori) lalu isi. Dipakai
# deploy/docker-compose.hostproxy.yml dan deploy/deploy-hostproxy.sh.
# Nilai ditulis apa adanya, tanpa tanda kutip, tanpa spasi, dan tanpa komentar di baris yang sama.

# --- Database ---
# Hanya huruf dan angka (dipakai di URL koneksi). Buat dengan: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Aplikasi ---
# Kunci Google AI Studio. Kosong = RAG/narasi memakai fallback, semua keputusan tetap jalan.
GEMINI_API_KEY=
# Nama model (kosong = bawaan config/app.yaml). Cari nama valid: python -m scripts.list_models
LLM_MODEL=
# Cadangan generate, dipisah koma, dicoba saat model utama 404 atau 429.
LLM_MODEL_FALLBACK=
# DIKUNCI bersama dimensi 768; mengganti berarti re-embed semua chunk.
EMBED_MODEL=
# Kunci POST /admin/*. Kosong = endpoint admin nonaktif (404). Buat dengan: openssl rand -hex 32
# WAJIB beda dari kunci smoke/development.
ADMIN_KEY=
# Origin frontend yang diizinkan (pisahkan koma), mis. https://jalurku-ui.contoh.id
CORS_ORIGINS=
# Nyalakan (true) sebelum rekam video dan submit. Ingest menolak baris tanpa terakhir_diverifikasi,
# dan API menolak start bila rules_jalur, ketentuan, atau acuan_skor masih memuat baris tanpa tanggal.
# Tanggal hanya diisi manusia setelah verifikasi. Cek kesiapan:
#   docker compose --project-directory deploy --env-file deploy/.env.prod -f deploy/docker-compose.hostproxy.yml exec api python -m scripts.check_verified
REQUIRE_VERIFIED=false

# --- Hostproxy (hanya compose ini) ---
# Port host (loopback saja) untuk api. api di kontainer selalu 8000; server block nginx host
# harus proxy_pass ke port yang sama (lihat deploy/nginx-host.conf.example).
APP_HOST_PORT=8000
# Folder PDF sumber RAG di host, di-mount ke /srv/data/dokumen di kontainer api.
# Buat dulu lalu atur izin agar bisa dibaca uid 10001 (pengguna kontainer, lihat README-hostproxy.md).
DOKUMEN_DIR=/srv/jalurku/dokumen

# --- Proxy tepercaya (rate limit per IP klien) ---
# Port api hanya dibuka di 127.0.0.1, jadi koneksi dari nginx host terlihat di dalam kontainer
# berasal dari IP gateway jaringan Docker, bukan IP klien asli. Agar X-Forwarded-For yang
# dipasang nginx host dibaca, cantumkan subnet jaringan `internal` compose ini (lihat
# networks di docker-compose.hostproxy.yml). Bila subnet diganti, ganti juga nilai ini.
# Tanpa ini, semua pengunjung berbagi satu jatah rate limit (IP gateway).
TRUSTED_PROXIES=172.31.0.0/24
