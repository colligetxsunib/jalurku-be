# Salin ke .env lalu isi. Berkas .env tidak boleh masuk repositori.

# Koneksi PostgreSQL (dev: docker compose up -d db memakai port host 5433)
DATABASE_URL=postgresql+psycopg://jalurku:jalurku@127.0.0.1:5433/jalurku
TEST_DATABASE_URL=postgresql+psycopg://jalurku:jalurku@127.0.0.1:5433/jalurku_test

# Kunci API dari Google AI Studio (langganan Google tidak otomatis termasuk API)
GEMINI_API_KEY=

# Kunci untuk POST /admin/ingest. Kosong = endpoint nonaktif (404).
ADMIN_KEY=

# Origin frontend yang diizinkan, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173

# Masa berlaku sesi dalam jam (menimpa config/app.yaml bila diisi)
SESSION_TTL_HOURS=24

# IP/CIDR reverse proxy yang dipercaya untuk X-Forwarded-For (kosong = tidak ada).
# Produksi (deploy/docker-compose.prod.yml) sudah menyetelnya ke subnet jaringan Docker.
TRUSTED_PROXIES=

# true = tolak data tanpa terakhir_diverifikasi saat ingest dan saat start.
# Nyalakan sebelum rekam video dan submit.
REQUIRE_VERIFIED=false

# dev | prod. prod mematikan /docs dan /openapi.json
APP_ENV=dev
